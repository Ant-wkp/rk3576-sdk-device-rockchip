#!/bin/sh
# Independent program is provisioned in userdata; never confirms a slot.
BIN=/userdata/ab-test/bin/rk_ab_watchdog
PID=/run/rk-ab-watchdog.pid
case "$1" in
    start)
        if [ ! -x "$BIN" ]; then
            echo "A/B watchdog owner missing; finite kernel takeover will expire" >&2
            exit 1
        fi
        start-stop-daemon -S -b -m -p "$PID" -x "$BIN"
        ;;
    stop)
        start-stop-daemon -K -p "$PID" -s TERM
        ;;
    restart) "$0" stop; "$0" start ;;
    *) echo "Usage: $0 {start|stop|restart}" >&2; exit 2 ;;
esac
